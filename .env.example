# Copy to .env and fill in. The app reads the committed prisma/dev.db by default,
# so you only NEED a token if you want to re-ingest fresh data from carde.io.

DATABASE_URL="file:./dev.db"
CARDE_API_BASE="https://api.cloudflare.riftbound.uvsgames.com/hydraproxy"

# Personal carde.io token (grab from a `hydraproxy` request's Authorization header
# while signed in to play.carde.io). Only needed for `npm run ingest:stores`.
CARDE_TOKEN=""
CARDE_AUTH_SCHEME="Token"

# Optional credentials instead of a token:
CARDE_EMAIL=""
CARDE_PASSWORD=""

# Rating tuning (Glicko-2). ELO_START doubles as the rating-scale center.
ELO_START="1500"
GLICKO_RD_START="350"        # initial rating deviation (uncertainty) for new players
GLICKO_VOL="0.06"            # initial volatility
GLICKO_TAU="0.5"             # how fast volatility may change
GLICKO_RD_MIN="30"           # RD floor
GLICKO_RD_ESTABLISHED="110"  # RD at/below which a rating is no longer provisional

# Ingest throughput. Requests are globally rate-limited to INGEST_RPS req/sec
# with up to INGEST_CONCURRENCY in flight. Raise for speed, lower to be gentler.
INGEST_RPS="10"
INGEST_CONCURRENCY="8"

# Neon control-plane API key, for `npm run neon:tune` (applies the compute/cost
# settings in COST.md). NOT needed by the app, the ingest, or the recompute.
# Neon Console -> Account settings -> API keys.
NEON_API_KEY=""
