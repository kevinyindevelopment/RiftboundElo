{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "riftelo",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-04-15",
	// nodejs_compat: Node built-ins the Next server + Prisma adapter need.
	// global_fetch_strictly_public: OpenNext's required fetch semantics.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// NOTE: do NOT add a `limits.cpu_ms` block — this account is on the Workers
	// Free plan and the API rejects it outright ("CPU limits are not supported
	// for the Free plan", code 100328), failing the whole deploy. The live
	// tournament page's CPU cost is managed in code instead: standings are
	// paginated and the Monte-Carlo sim count scales with field size.
	// Incremental cache store for ISR pages + `unstable_cache` query results.
	// The binding NAME is fixed by the OpenNext adapter — it looks up exactly
	// `NEXT_INC_CACHE_KV` (see open-next.config.ts). Without this the app falls
	// back to querying Neon on every request.
	// Created with:  npx wrangler kv namespace create NEXT_INC_CACHE_KV
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "d0342292048547c2bb915e576e2dc1d5" }
	],
	// Keep the free riftelo.<your-subdomain>.workers.dev URL alive alongside the
	// custom route — it's our runtime smoke-test target before DNS is wired.
	"workers_dev": true,
	// Serve only the /riftelo path of the apex; the rest of kevin-yin.com is left
	// free for other content. Enabled after the workers.dev runtime check passes
	// (needs the zone in your CF account + a proxied DNS record for the hostname).
	"routes": [
		{ "pattern": "kevin-yin.com/riftelo*", "zone_name": "kevin-yin.com" }
	]
}
