{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "riftelo",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-04-15",
	// nodejs_compat: Node built-ins the Next server + Prisma adapter need.
	// global_fetch_strictly_public: OpenNext's required fetch semantics.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// NOTE: do NOT add a `limits.cpu_ms` block — this account is on the Workers
	// Free plan and the API rejects it outright ("CPU limits are not supported
	// for the Free plan", code 100328), failing the whole deploy. The live
	// tournament page's CPU cost is managed in code instead: standings are
	// paginated and the Monte-Carlo sim count scales with field size.
	// Incremental cache store for ISR pages + `unstable_cache` query results.
	// The binding NAME is fixed by the OpenNext adapter — it looks up exactly
	// `NEXT_INC_CACHE_KV` (see open-next.config.ts). Without this the app falls
	// back to querying Neon on every request.
	// Created with:  npx wrangler kv namespace create NEXT_INC_CACHE_KV
	//
	// ⚠️ KV's free tier is 1,000 writes/DAY, shared ACROSS THE WHOLE ACCOUNT with
	// riftmarket — and blowing it kills the cache SILENTLY (see the long note in
	// open-next.config.ts and the incident in COST.md). This is only safe because
	// /riftelo* is now behind Cloudflare Access + a WAF crawler block, which cut
	// traffic to a single user. Reopening the site publicly REQUIRES moving this
	// to R2 first.
	"kv_namespaces": [
		{ "binding": "NEXT_INC_CACHE_KV", "id": "d0342292048547c2bb915e576e2dc1d5" }
	],
	// DISABLED Aug 2026. The workers.dev hostname is NOT covered by the zone's
	// WAF rules or by Cloudflare Access, so while it was on it served the entire
	// app unauthenticated to anyone who found it — a complete bypass of the
	// lockdown below. workers.dev subdomains are routinely scanned, so this is
	// not theoretical. Already turned off live via the API; keep it false so a
	// deploy cannot silently re-open it.
	//
	// Consequence: deploy.sh's first smoke-test URL no longer resolves. Verify
	// against kevin-yin.com/riftelo instead, which returns 302 (the Access login
	// redirect) when healthy — NOT 200.
	"workers_dev": false,
	// Serve only the /riftelo path of the apex; the rest of kevin-yin.com is left
	// free for other content. Enabled after the workers.dev runtime check passes
	// (needs the zone in your CF account + a proxied DNS record for the hostname).
	"routes": [
		{ "pattern": "kevin-yin.com/riftelo*", "zone_name": "kevin-yin.com" }
	]
}
